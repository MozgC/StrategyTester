<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent core: strategies, walk-forward / Monte Carlo / monkey testers, price providers.
       TargetFramework (net10.0) comes from Directory.Build.props. No WinForms here, so tests can run on any OS. -->
  <PropertyGroup>
    <RootNamespace>StrategyTester</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AlphaVantage.Net.Common" Version="2.0.2" />
    <PackageReference Include="AlphaVantage.Net.Core" Version="2.0.2" />
    <PackageReference Include="AlphaVantage.Net.Stocks" Version="2.0.2" />
    <PackageReference Include="CodeJam" Version="4.1.0" />
    <PackageReference Include="FastCloner" Version="3.3.23" />
    <PackageReference Include="OoplesFinance.YahooFinanceAPI" Version="1.7.1" />
  </ItemGroup>

</Project>
